{
  "name": "bdt-ledger-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "pretest": "npm run build:domain",
    "test:rules": "firebase emulators:exec --project demo-agency-ledger --only firestore \"node --test tests/firestore.emulator.mjs\"",
    "deploy:firebase": "firebase deploy --only firestore --project robins-e3132",
    "test:integration": "npm run build:domain && firebase emulators:exec --project demo-agency-ledger --only auth,firestore \"node --test tests/direct-firestore.emulator.mjs\"",
    "build:domain": "node scripts/build-domain.mjs",
    "prebuild": "npm run build:domain"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.31.0",
    "typescript": "latest"
  }
}
